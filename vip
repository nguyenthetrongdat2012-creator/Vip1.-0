local function ClearTimer()
    if SongTimer then
        pcall(function() task.cancel(SongTimer) end)
        SongTimer = nil
    end
end

local function LoadSong(index)
    if IsLoading then return end
    IsLoading = true
    ClearTimer()
    if not index or index > #Playlist then index = 1 end
    if index < 1 then index = #Playlist end
    CurrentSong = index
    local song = Playlist[index]
    pcall(function() BGM:Stop() end)
    task.wait(0.1)
    BGM.SoundId = "rbxassetid://" .. song.id
    BGM.TimePosition = 0
    local waitLoad = 0
    while BGM.TimeLength == 0 and waitLoad < 3 do
        task.wait(0.1)
        waitLoad = waitLoad + 0.1
    end
    pcall(function() BGM:Play() end)
    if _G.MusicNowPlaying then
        _G.MusicNowPlaying.Text = "♪ " .. song.name
    end
    if _G.RefreshMusicList then pcall(_G.RefreshMusicList) end
    local length = BGM.TimeLength
    if length > 0 then
        SongTimer = task.delay(length + 2, function() LoadSong(CurrentSong + 1) end)
    else
        SongTimer = task.delay(10, function() LoadSong(CurrentSong + 1) end)
    end
    task.wait(0.2)
    IsLoading = false
end

