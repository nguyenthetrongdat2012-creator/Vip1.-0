local function solveMinigame()
    local pgui = P:FindFirstChild("PlayerGui")
    if not pgui then return end

    local miniGui = pgui:FindFirstChild("Minigame") or pgui:FindFirstChild("FishingGame") or pgui:FindFirstChild("Reel")
    if not miniGui then
        for _, g in pairs(pgui:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled and (g.Name:lower():find("fish") or g.Name:lower():find("mini")) then
                miniGui = g
                break
            end
        end
    end
    if not miniGui or not miniGui.Enabled then return end

    local bar = miniGui:FindFirstChild("Bar", true) or miniGui:FindFirstChild("PlayerBar", true)
    local target = miniGui:FindFirstChild("Target", true) or miniGui:FindFirstChild("Fish", true)

    if bar and target then
        if bar.AbsolutePosition.X < target.AbsolutePosition.X then
            VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        else
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end
end

